{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-vcpkg",
      "displayName": "PCem - Visual Studio 2026 x64",
      "description": "Native MSVC x64 build using vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "PCEM_DISPLAY_ENGINE": "wxWidgets",
        "PLUGIN_ENGINE": "ON",
        "USE_NETWORKING": "ON",
        "USE_PCAP_NETWORKING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-vcpkg-debug",
      "displayName": "PCem - Debug x64",
      "configurePreset": "vs2026-vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-vcpkg-release",
      "displayName": "PCem - Release x64",
      "configurePreset": "vs2026-vcpkg",
      "configuration": "Release"
    }
  ]
}
